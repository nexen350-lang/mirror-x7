<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" android:maxSdkVersion="33" />
    <!-- Keeps a mirroring session and its remote audio alive while the app is not on screen. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!--
      Android 14 and newer start a connectedDevice service only for an app holding one of a few
      permissions; this is the one its documentation lists for a device reached over a network.
      Granted at install, with no prompt. Without it the start throws and takes the app down.
    -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      libadb-android's AAR manifest declares no targetSdkVersion, so the merger implies the
      legacy permissions an ancient app would have needed. None of them are used: nothing here
      reads telephony state, and every file this app touches goes through the Storage Access
      Framework. Shipping them would ask users of a screen-mirroring app for Phone access.
    -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />

    <!--
      Predictive back is asked for activity by activity; Android 13 reads only this application
      value, and shows its animations only behind a developer option, so it has the older Back
      everywhere. The mirror screen keeps the older Back on every version: see MirrorActivity.
    -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="false"
        tools:targetApi="33"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScrcpyRemote">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            android:enableOnBackInvokedCallback="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.ScrcpyRemote"
            tools:targetApi="34">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Quick-connect deep link: scrcpy://connect?host=192.168.1.20&port=5555 -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="scrcpy" />
            </intent-filter>

            <!-- Share a file straight to a device: the picked device is connected and sent it. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!--
          The older Back, on purpose: a mouse's Back button also arrives as a Back key, which the
          screen drops because the button press already went to the device. Predictive back hands
          that key to the back handling before the screen sees it, so one click went back on the
          device and asked to end the session.
        -->
        <activity
            android:name=".ui.MirrorActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|smallestScreenSize"
            android:enableOnBackInvokedCallback="false"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:theme="@style/Theme.ScrcpyRemote.Mirror"
            android:windowSoftInputMode="adjustResize"
            tools:targetApi="34" />

        <service
            android:name=".session.MirrorSessionService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback|dataSync|connectedDevice" />

        <!--
            Hands a captured screenshot or recording to another app.

            Not exported and with no permission of its own: the only way in is a URI this app
            passed out with a read grant attached, which Android ties to the receiving app and
            drops when the task ends. The paths it can serve are narrowed in shared_artefacts.xml
            to the two directories those artefacts live in.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.artefacts"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_artefacts" />
        </provider>
    </application>

</manifest>
